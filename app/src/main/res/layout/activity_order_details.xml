<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.OrderDetailsActivity">

    <TextView
        android:layout_margin="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/orderHeader"
        android:text="Order Details"
        android:textSize="20dp"
        android:gravity="center"
        android:textColor="@color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/header"
        app:layout_constraintTop_toBottomOf="@+id/orderHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:weightSum="3"
        android:gravity="center"
        android:layout_margin="10dp"
        android:orientation="horizontal"
        android:layout_height="40dp">
        <TextView
            android:gravity="center_vertical"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:text="Product Name"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="40dp"/>
        <TextView
            android:gravity="center_vertical"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:text="Quantity"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="40dp"/>
        <TextView
            android:gravity="center_vertical"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:text="Remaining"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="40dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/rvMain"
        app:layout_constraintBottom_toTopOf="@+id/orderCompleteBtn"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <Button
        android:padding="10dp"
        android:layout_margin="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/orderCompleteBtn"
        android:text="Start Scanning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <androidx.constraintlayout.widget.Group
        android:visibility="gone"
        android:background="@drawable/action_dialog_bg"
        app:constraint_referenced_ids="actionDialogHeadingEtv,actionDialogHeadingTv,
        actionDialogScannedBtn,bottomDivider,actionDialogClose"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:id="@+id/actionDialog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottomDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/actionDialogHeadingTv" />

    <TextView
        android:layout_margin="20dp"
        android:paddingTop="20dp"
        android:id="@+id/actionDialogHeadingTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20sp"
        android:text="Scan Basket QR Code"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/actionDialogHeadingEtv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <EditText
        android:gravity="center"
        android:id="@+id/actionDialogHeadingEtv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:padding="10dp"
        android:background="@drawable/edittextbg"
        android:hint="Enter QR Scanner Code"
        android:textColor="@color/black"
        android:textColorHint="#aaaaaa"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/actionDialogScannedBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actionDialogHeadingTv" />

    <Button
        android:id="@+id/actionDialogScannedBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:padding="10dp"
        android:text="Start Scanning"
        app:layout_constraintTop_toBottomOf="@+id/actionDialogHeadingEtv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomDivider" />
    <ImageView
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actionDialogScannedBtn"
        android:id="@+id/bottomDivider"
        android:layout_width="wrap_content"
        android:layout_height="30dp"/>

    <ImageView
        android:layout_margin="15dp"
        app:layout_constraintTop_toTopOf="@+id/actionDialog"
        app:layout_constraintEnd_toEndOf="@+id/actionDialog"
        android:src="@drawable/ic_action_cross_black"
        android:id="@+id/actionDialogClose"
        android:layout_width="25dp"
        android:layout_height="25dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>