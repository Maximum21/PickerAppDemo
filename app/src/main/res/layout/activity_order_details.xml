<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".main.OrderDetailsActivity">

    <TextView
        android:layout_margin="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/orderHeader"
        android:text="Order Details"
        android:textSize="20dp"
        android:gravity="center"
        android:textColor="@color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/header"
        app:layout_constraintTop_toBottomOf="@+id/orderHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:weightSum="3"
        android:gravity="center"
        android:layout_margin="10dp"
        android:orientation="horizontal"
        android:layout_height="40dp">
        <TextView
            android:gravity="center_vertical"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:text="Product Name"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="40dp"/>
        <TextView
            android:gravity="center_vertical"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:text="Quantity"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="40dp"/>
        <TextView
            android:gravity="center_vertical"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:text="Remaining"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="40dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/rvMain"
        app:layout_constraintBottom_toTopOf="@+id/orderCompleteBtn"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <Button
        android:padding="10dp"
        android:layout_margin="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/orderCompleteBtn"
        android:text="Order Completed / Start Scanning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>