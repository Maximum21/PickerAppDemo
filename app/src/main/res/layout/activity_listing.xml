<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ListingActivity">

    <segmented_control.widget.custom.android.com.segmentedcontrol.SegmentedControl
        android:id="@+id/segmented_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:columnCount="3"
        app:distributeEvenly="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="12dp"
        app:segments="@array/state_type"
        app:selectedBackgroundColor="@color/black"
        app:selectedStrokeColor="@color/black"
        app:selectedTextColor="@color/white"
        app:textVerticalPadding="6dp"
        app:unSelectedBackgroundColor="@color/white"
        app:unSelectedStrokeColor="@color/black"
        app:unSelectedTextColor="@color/black" />

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        android:weightSum="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/segmented_control">

        <TextView
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1.8"
            android:gravity="center_vertical"
            android:text="Product Name"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight=".6"
            android:gravity="center"
            android:text="Quantity"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight=".6"
            android:gravity="center"
            android:text="Picked"
            android:textColor="@color/black"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/orderCompleteBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header" />

    <Button
        android:id="@+id/orderCompleteBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:padding="10dp"
        android:text="Start Scanning"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.Group
        android:visibility="gone"
        android:background="@drawable/action_dialog_bg"
        app:constraint_referenced_ids="actionDialogHeadingEtv,actionDialogHeadingTv,
        actionDialogScannedBtn,bottomDivider,actionDialogClose"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:id="@+id/actionDialog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottomDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/actionDialogHeadingTv" />

    <TextView
        android:layout_margin="20dp"
        android:paddingTop="20dp"
        android:id="@+id/actionDialogHeadingTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20sp"
        android:text="Scan Basket QR Code"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/actionDialogHeadingEtv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <EditText
        android:gravity="center"
        android:id="@+id/actionDialogHeadingEtv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:padding="10dp"
        android:background="@drawable/edittextbg"
        android:hint="Enter QR Scanner Code"
        android:textColor="@color/black"
        android:textColorHint="#aaaaaa"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/actionDialogScannedBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actionDialogHeadingTv" />

    <Button
        android:id="@+id/actionDialogScannedBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:padding="10dp"
        android:text="Start Scanning"
        app:layout_constraintTop_toBottomOf="@+id/actionDialogHeadingEtv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomDivider" />
    <ImageView
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actionDialogScannedBtn"
        android:id="@+id/bottomDivider"
        android:layout_width="wrap_content"
        android:layout_height="30dp"/>

    <ImageView
        android:layout_margin="15dp"
        app:layout_constraintTop_toTopOf="@+id/actionDialog"
        app:layout_constraintEnd_toEndOf="@+id/actionDialog"
        android:src="@drawable/ic_action_cross_black"
        android:id="@+id/actionDialogClose"
        android:layout_width="25dp"
        android:layout_height="25dp"/>

    <RelativeLayout
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:background="#55cccccc"
        android:id="@+id/progressView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true">
        <ProgressBar
            android:layout_centerInParent="true"
            android:layout_width="70dp"
            android:layout_height="70dp"/>
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>